# Deliberate source distribution: rebuildable code and public root metadata only.
# Tests and development history remain in Git, pending their separate privacy review.
include pyproject.toml MANIFEST.in README.md CHANGELOG.md LICENSE
recursive-include src/seestar_toolkit *.py
prune tests
prune docs
prune tools
prune .private-real-data
global-exclude *.fit *.fits *.py[cod] .DS_Store
global-exclude __pycache__/*
